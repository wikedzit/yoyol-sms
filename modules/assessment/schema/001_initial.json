        { "name": "subject_id", "type": "reference", "references": "academics.subjects", "onDelete": "cascade", "notNull": true },
        { "name": "stream_id", "type": "reference", "references": "academics.academic_streams", "onDelete": "cascade", "notNull": true },
        { "name": "form_id", "type": "reference", "references": "academics.academic_forms", "onDelete": "cascade", "notNull": true },
        { "name": "teacher_id", "type": "reference", "references": "staff.teachers", "onDelete": "set null" },
        { "name": "status", "type": "text", "notNull": true, "default": "Active" },
