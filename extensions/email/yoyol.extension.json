{
  "manifestVersion": 1,
  "key": "email",
  "type": "plugin",
  "version": "1.0.0",
  "name": { "en": "Email", "sw": "Barua pepe" },
  "description": {
    "en": "Records an email for a guardian. Nothing is sent until a gateway is configured.",
    "sw": "Inarekodi barua pepe kwa mlezi. Hakuna kinachotumwa hadi lango la barua liwekwe."
  },
  "publisher": "nottech",
  "license": "MIT",
  "requires": { "core": "^1.0.0" },
  "capabilities": ["notifications:send"],
  "hooks": {
    "listens": [{ "name": "navigation.items" }]
  },
  "settings": [
    { "key": "sender", "type": "text", "default": "" },
    { "key": "gateway", "type": "text", "default": "" }
  ],
  "provides": ["notifications.channel"],
  "outboundHosts": []
}
