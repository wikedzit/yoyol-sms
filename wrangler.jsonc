{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yoyol-students-system",
	"compatibility_date": "2025-04-04",
	"main": "./workers/app.ts",
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yoyo-student-system",
			"database_id": "5dd1b87b-f0f5-4a52-a280-fb1ab34602a9",
			"migrations_dir": "./workers/drizzle"
		}
	]
}
