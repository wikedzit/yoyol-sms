{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yoyol-students-system",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "vars": {
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoyol-student-system",
      "database_id": "6923e920-0852-40ef-bc6b-49aa8bb4a7f4",
      "migrations_dir": "./workers/drizzle",
    },
  ],
  "env": {
    "development": {
      "vars": {
        "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yoyol-student-system-development",
          "database_id": "32375355-5046-4098-9719-553a036ab578",
          "migrations_dir": "./workers/drizzle",
        },
      ],
    },
  },
}
